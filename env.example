# Credenciais do ZEMPO CBJ
ZEMPO_CODIGO=JU079588
ZEMPO_SENHA=sua_senha_aqui

# Configurações da API
PORT=3000

# Múltiplas chaves: JSON com { "chave": "nome/label" }
# Gere cada chave com: openssl rand -hex 32
API_KEYS={"chave_do_dev":"dev","chave_usuario1":"usuario1"}

# Alternativa simples para chave única (retrocompatível):
# API_KEY=minha_chave_secreta_aqui

# Cache (em segundos)
SESSION_CACHE_TTL=3600      # 1 hora   - tempo que a sessão ZEMPO é reutilizada
USER_DATA_CACHE_TTL=3600    # 1 hora   - tempo que dados de atletas ficam em cache
CLUBES_CACHE_TTL=172800     # 2 dias   - tempo que listas de clubes ficam em cache

# URL base do ZEMPO
ZEMPO_BASE_URL=https://zempo.com.br

ZEMPO_CONCURRENCY=5